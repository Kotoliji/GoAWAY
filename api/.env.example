# Copy to .env and fill in. Never commit the real .env.
PORT=3000

# Oracle connection (node-oracledb thin mode — no Instant Client needed)
DB_USER=tvdept
DB_PASSWORD=tvdept
# docker compose → XEPDB1; a manual XE install may use localhost:1521/XE
DB_CONNECT_STRING=localhost:1521/XEPDB1

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
