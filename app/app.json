{
  "expo": {
    "name": "TVDEPT",
    "slug": "tvdept",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tvdept",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TVDEPT uses your location to request and track rides."
      },
      "bundleIdentifier": "pt.tvdept.app"
    },
    "android": {
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "pt.tvdept.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TVDEPT uses your location to request and track rides."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5FFF"
        }
      ]
    ]
  }
}
